# ==============================================================================
# Personal ADK Gaming Assistant - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# Do NOT commit .env with actual API keys to version control.

# Google Gemini API Key for Agent Development Kit (ADK)
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Vertex AI flag (set to False when using Gemini API keys directly)
GOOGLE_GENAI_USE_VERTEXAI=False

# RLStats API Key for Rocket League statistics and leaderboards
# Obtainable from https://api.rlstats.net
RLSTATS_API_KEY=your_rlstats_api_key_here
